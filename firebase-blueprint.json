{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Showcase portfolio project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "galleryUrls": { "type": "array" },
        "technologies": { "type": "array" },
        "link": { "type": "string" },
        "githubUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category", "description", "imageUrl"]
    },
    "Timeline": {
      "title": "Timeline",
      "description": "Education and career experience milestones",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["education", "experience"] },
        "title": { "type": "string" },
        "institution": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "skills": { "type": "array" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "title", "institution", "period", "description"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client review and testimonial",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientRole": { "type": "string" },
        "company": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientName", "clientRole", "content"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inquiry message received via portfolio contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "replied": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global portfolio configuration, branding, hero and theme",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string" },
        "adminEmail": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "hero": { "type": "object" },
        "branding": { "type": "object" },
        "theme": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "SystemUser": {
      "title": "SystemUser",
      "description": "Enterprise system user account with role assignment and status",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "roleId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "locked", "disabled"] },
        "customOverrides": { "type": "object" },
        "avatarUrl": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "lastLoginIp": { "type": "string" }
      },
      "required": ["fullName", "username", "email", "roleId", "status"]
    },
    "SystemRole": {
      "title": "SystemRole",
      "description": "Role preset with capability matrix page-to-tab permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isCoreLocked": { "type": "boolean" },
        "color": { "type": "string" },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "isCoreLocked", "permissions"]
    },
    "AuditLogItem": {
      "title": "AuditLogItem",
      "description": "Read-only history action audit log entry",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "actionType": { "type": "string", "enum": ["create", "update", "delete", "login", "permission_change"] },
        "targetPage": { "type": "string" },
        "targetTab": { "type": "string" },
        "details": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "ipAddress": { "type": "string" }
      },
      "required": ["timestamp", "userId", "userName", "userRole", "actionType", "targetPage", "details"]
    },
    "SecurityAuditItem": {
      "title": "SecurityAuditItem",
      "description": "Security event monitoring log (failed logins, role changes, escalations, locks)",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "eventType": { "type": "string", "enum": ["failed_login", "role_change", "permission_escalation", "account_lock"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "ipAddress": { "type": "string" },
        "device": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["timestamp", "eventType", "severity", "ipAddress", "device", "details"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Portfolio showcase projects collection"
    },
    "/timelines/{timelineId}": {
      "schema": { "$ref": "#/entities/Timeline" },
      "description": "Education and career experience milestones"
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Client reviews and endorsements"
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Client inquiries and contact form submissions"
    },
    "/site_settings/{settingsId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Configurable portfolio settings and branding"
    },
    "/system_users/{userId}": {
      "schema": { "$ref": "#/entities/SystemUser" },
      "description": "Enterprise system user accounts"
    },
    "/system_roles/{roleId}": {
      "schema": { "$ref": "#/entities/SystemRole" },
      "description": "Role presets with page-to-tab permissions matrix"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogItem" },
      "description": "System history audit logs"
    },
    "/security_audit_logs/{securityLogId}": {
      "schema": { "$ref": "#/entities/SecurityAuditItem" },
      "description": "High-priority security logs and brute force alerts"
    }
  }
}
